# Example configuration for local development.
#
# Copy to .env for local use. `.env` is gitignored, and gitleaks will block it if the
# ignore is ever removed - see SEC-1, where a committed .env kept working for 41
# months after it was deleted.
#
# In the cluster none of these come from a file: non-secret values are in a ConfigMap
# and secrets are synced from AWS Secrets Manager.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

PGHOST=localhost
PGPORT=5432
PGDATABASE=agribridge
PGUSER=agribridge
PGPASSWORD=localdev
PG_POOL_MAX=10

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
CACHE_TTL_SECONDS=30

# Development only. Production generates this in Terraform and stores it in
# Secrets Manager; the application refuses to start in production without it.
JWT_SECRET=local-development-only-secret
BCRYPT_ROUNDS=8

RUN_MIGRATIONS=true
SEED_DEMO_DATA=true
TRUST_PROXY=true

# Injected at image build time from the git context, not set by hand.
# GIT_SHA=
# APP_VERSION=
# IMAGE_TAG=
