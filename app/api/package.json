{
  "name": "agribridge-api",
  "version": "1.0.0",
  "description": "AgriBridge marketplace API - DevOps capstone reference application",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node -e \"import('./src/migrate.js').then(m=>m.runMigrations()).then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "seed": "node -e \"import('./src/seed.js').then(m=>m.seedDemoData()).then(r=>{console.log(JSON.stringify(r,null,2));process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "test": "vitest run --dir test/unit",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:coverage": "vitest run --dir test/unit --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.6",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "prom-client": "15.1.3",
    "redis": "4.7.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.17.0",
    "supertest": "7.0.0",
    "vitest": "2.1.8"
  }
}
