# AWS credentials for Terraform.
#
# Copy this to `aws.env`, put your real keys in it, and source it before
# running Terraform:
#
#     cp aws.env.example aws.env
#     # edit aws.env
#     source aws.env
#     cd infra/bootstrap && terraform apply
#
# WHY A SOURCED FILE RATHER THAN ~/.aws/credentials OR A .tfvars FILE
#
#   ~/.aws/credentials   Editing it risks disturbing an AWS account you already
#                        have configured on this machine. This approach writes
#                        nothing there, so your existing setup is never read and
#                        never modified.
#
#   terraform.tfvars     Those files ARE committed - they carry the region, the
#                        instance size, the NodePorts. Putting AWS keys in one
#                        is exactly how finding SEC-1 happened: a credentials
#                        file committed in May 2022, deleted three days later,
#                        and still valid 41 months on because deleting a file
#                        does not remove it from Git history.
#
#   aws.env              Excluded by .gitignore, and gitleaks would block the
#                        push even if the ignore rule were removed. Two
#                        independent controls, which is the point.
#
# The Terraform AWS provider reads these variables natively. You do not need
# the AWS CLI installed for any of this.
#
# ---------------------------------------------------------------------------
# AFTERWARDS: delete this access key in the IAM console once the recording is
# done. A key that exists is a key that can leak.
# ---------------------------------------------------------------------------

export AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
export AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
export AWS_DEFAULT_REGION="eu-west-1"

# If you are using temporary credentials from AWS SSO or an assumed role,
# uncomment and set this as well:
# export AWS_SESSION_TOKEN="..."
